# ── Database (Neon) ─ leave unset locally to use the embedded PGlite database in .data/
DATABASE_URL=

# ── Google OAuth client (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application")
#    Authorized redirect URI:  https://sevcp.sedc.gov.ng/office-hours/api/auth/google/callback
#    (local: http://localhost:4620/office-hours/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# live | mock. Defaults to live when GOOGLE_CLIENT_ID is set, otherwise mock (simulated calendar, no real invites).
GOOGLE_MODE=

# Public origin the app is served from (used for OAuth redirects and founder manage links)
PUBLIC_BASE_URL=https://sevcp.sedc.gov.ng

# Fixed invitees (JSON array; see lib/config.ts). Exactly one "role":"host"; add "optional":true for optional guests.
OFFICE_HOURS_ATTENDEES=

# Comma-separated Google accounts allowed into /office-hours/admin
ADMIN_EMAILS=

# Long random strings (e.g. `openssl rand -base64 48`). ENCRYPTION_KEY encrypts the stored Google refresh token;
# SESSION_SECRET signs admin sessions and founder manage links (rotating it invalidates existing manage links).
ENCRYPTION_KEY=
SESSION_SECRET=

# Vercel Cron sends this as a Bearer token to /office-hours/api/cron/reconcile
CRON_SECRET=
